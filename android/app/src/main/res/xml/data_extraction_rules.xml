<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) extraction rules.

  android:allowBackup="false" already kills cloud/adb backup, but on API 31+ it
  does NOT stop device-to-device transfer — that path is controlled here. Every
  domain is excluded because everything we store is sensitive: the Supabase
  session (refresh token) lives in SharedPreferences in plaintext, and
  Documents/ holds the scripts, the recordings, debug_log.txt and the sqlite DB.
  A restored copy of any of that hands over a live signed-in session.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
